PORT=5000
NODE_ENV=development
# Local: mongodb://127.0.0.1:27017/medlink  |  Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/medlink
MONGODB_URI=mongodb://127.0.0.1:27017/medlink
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=2h
# Remember-me session length in days
REMEMBER_ME_DAYS=14
CLIENT_URL=http://localhost:5173
MAX_FILE_SIZE_MB=10
